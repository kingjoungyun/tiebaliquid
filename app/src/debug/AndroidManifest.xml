<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 源集：临时/常驻的「真玻璃」验证页。
  用途：不碰主界面，先确认 Glasmio 的折射/模糊在真机（模拟器）上确实生效。
  启动：adb shell am start -n com.tieba/com.huanchengfly.tieba.post.debug.GlassPlaygroundActivity
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name=".debug.GlassPlaygroundActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <!-- B 版设置页（纯 Glasmio），A/B 对照用；导出以便 adb shell am start 直接拉起。 -->
        <activity
            android:name=".debug.GlassSettingsPreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
