<?xml version="1.0" encoding="utf-8"?>
<!--
  仅 debug 源集：Glasmio 验证 / 控件总览页。
  启动：adb shell am start -n com.tieba/com.huanchengfly.tieba.post.debug.GlassGalleryActivity
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Stage 1 · Nav3 底栏沙盒（只做隔离验证，不进生产） -->
        <activity
            android:name=".debug.Nav3DockSandboxActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <!-- P2/C：Glasmio 控件总览（可交互） -->
        <activity
            android:name=".debug.GlassGalleryActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name=".debug.GlassPlaygroundActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <!-- B 版设置页（纯 Glasmio），A/B 对照用；导出以便 adb shell am start 直接拉起。 -->
        <activity
            android:name=".debug.GlassSettingsPreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <!-- 技术验证页：GlasmioCard 帖子卡（验证 A）+ 跨窗口 GlasmioMenu 采背景（验证 B）。 -->
        <activity
            android:name=".debug.GlassFeedPreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <!-- 推特式帖子卡（生产组件 PostCard）的静态数据验收页：浅色/深色/点赞/多图。 -->
        <activity
            android:name=".debug.PostCardPreviewActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
    </application>
</manifest>
